# Resend (https://resend.com) — used by /api/request-access to email new
# Early Access leads. Create an account, verify the getramz.com sending
# domain, and generate an API key.
RESEND_API_KEY=

# Inbox that receives "Request Early Access" submissions.
LEADS_TO_EMAIL=hello@getramz.com

# Verified "from" address for outgoing mail (must be on a domain verified in
# Resend — usually a getramz.com subdomain, e.g. notify@getramz.com).
LEADS_FROM_EMAIL=
